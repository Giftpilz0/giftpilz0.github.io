---
import { Icon } from "@astrojs/starlight/components";
import { getCategories } from "../lib/category-pages";
import { topics } from "../lib/topics";

const cards = await Promise.all(
  topics.map(async (topic) => {
    const categories = await getCategories(topic.dir);
    const pages = categories.reduce((sum, category) => sum + category.pages, 0);
    return { ...topic, categories, pages };
  }),
);
---

<div class="topics not-content">
  {
    cards.map(({ label, link, icon, unit, categories, pages }) => (
      <section>
        <a class="head" href={link}>
          <span class="icon">
            <Icon name={icon} size="1.5rem" />
          </span>
          <span>
            <span class="title">{label}</span>
            <span class="stats">
              {categories.length} categories · {pages} {unit}s
            </span>
          </span>
          <Icon name="right-arrow" class="arrow" size="1.25rem" />
        </a>
        <ul class="chips">
          {categories.map((category) => (
            <li>
              <a href={category.href}>{category.label}</a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<style>
  .topics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 1rem;
  }
  section {
    display: grid;
    align-content: start;
    gap: 1.25rem;
    padding: 1.5rem;
    border-radius: 1.75rem;
    background: var(--md-sys-color-surface-container);
  }
  .head {
    display: flex;
    align-items: center;
    gap: 1rem;
    color: var(--md-sys-color-on-surface);
    text-decoration: none;
  }
  .icon {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 1rem;
    background: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
  }
  .title {
    display: block;
    font-size: var(--sl-text-2xl);
    font-weight: 600;
    line-height: 1.2;
  }
  .stats {
    color: var(--md-sys-color-on-surface-variant);
  }
  .arrow {
    margin-inline-start: auto;
    color: var(--md-sys-color-primary);
    transition: transform 0.15s;
  }
  .head:hover .arrow {
    transform: translateX(0.25rem);
  }
  .head:hover .title {
    color: var(--md-sys-color-primary);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .chips a {
    display: block;
    padding: 0.375rem 0.875rem;
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: 0.5rem;
    color: var(--md-sys-color-on-surface-variant);
    font-size: var(--sl-text-sm);
    font-weight: 500;
    text-decoration: none;
  }
  .chips a:hover,
  .chips a:focus-visible {
    border-color: transparent;
    background: var(--md-sys-color-secondary-container);
    color: var(--md-sys-color-on-secondary-container);
  }
</style>
