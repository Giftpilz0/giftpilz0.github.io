---
import { getCategories } from "../lib/category-pages";

interface Props {
  dir: string;
  unit?: string;
}

const { dir, unit = "page" } = Astro.props;
const categories = await getCategories(dir);
---

<ul class="tiles not-content">
  {
    categories.map(({ label, href, pages }) => (
      <li>
        <a href={href}>
          <span class="monogram" aria-hidden="true">
            {label.charAt(0)}
          </span>
          <span class="text">
            <span class="label">{label}</span>
            <span class="count">
              {pages} {unit}
              {pages === 1 ? "" : "s"}
            </span>
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    gap: 0.75rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  a {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0.875rem 1rem;
    border-radius: 1rem;
    background: var(--md-sys-color-surface-container);
    color: var(--md-sys-color-on-surface);
    text-decoration: none;
    transition: background-color 0.15s;
  }
  a:hover,
  a:focus-visible {
    background: var(--md-sys-color-surface-container-highest);
  }
  .monogram {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.75rem;
    background: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
    font-size: 1.125rem;
    font-weight: 600;
  }
  .text {
    display: grid;
  }
  .label {
    font-weight: 600;
    line-height: 1.3;
  }
  .count {
    color: var(--md-sys-color-on-surface-variant);
    font-size: var(--sl-text-sm);
  }
</style>
