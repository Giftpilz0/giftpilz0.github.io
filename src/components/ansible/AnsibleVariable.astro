---
import type { AnsibleVariable } from "../../content.config";

interface Props {
  variable: AnsibleVariable;
  parent?: string;
}

const { variable, parent } = Astro.props;
const path = parent ? `${parent}.${variable.name}` : variable.name;
const kind = variable.type.split("[")[0];
const search = [path, variable.description, ...(variable.options ?? []).map((o) => o.name)]
  .join(" ")
  .toLowerCase();
---

<li class="variable" id={`var-${path}`} data-search={search}>
  <div class="head">
    <a class="name" href={`#var-${path}`}>{variable.name}</a>
    <span class={`chip type-${kind}`}>{variable.type}</span>
    {variable.required && <span class="chip required">required</span>}
  </div>
  {variable.description && <p class="description">{variable.description}</p>}
  {
    variable.choices && (
      <div class="field">
        <span class="key">Choices</span>
        {variable.choices.map((choice) => (
          <code>{choice}</code>
        ))}
      </div>
    )
  }
  {
    variable.default !== undefined && (
      <div class="field">
        <span class="key">Default</span>
        {variable.default.includes("\n") ? <pre>{variable.default}</pre> : <code>{variable.default}</code>}
      </div>
    )
  }
  {
    variable.options && (
      <ul class="options">
        {variable.options.map((option) => (
          <Astro.self variable={option} parent={path} />
        ))}
      </ul>
    )
  }
</li>

<style>
  .variable {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.5rem;
    padding: 1rem 1.25rem;
    border-radius: 1rem;
    background: var(--md-sys-color-surface-container-low);
    scroll-margin-top: calc(var(--sl-nav-height) + 1rem);
  }
  .variable:target {
    outline: 2px solid var(--md-sys-color-primary);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .name {
    margin-inline-end: 0.25rem;
    color: var(--md-sys-color-primary);
    font-family: var(--__sl-font-mono);
    font-weight: 600;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .name:hover {
    text-decoration: underline;
  }
  .chip {
    padding: 0.125rem 0.625rem;
    border-radius: 0.5rem;
    background: var(--md-sys-color-surface-container-highest);
    color: var(--md-sys-color-on-surface-variant);
    font-size: var(--sl-text-xs);
    font-weight: 500;
  }
  .type-str {
    background: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
  }
  .type-bool {
    background: var(--md-sys-color-tertiary-container);
    color: var(--md-sys-color-on-tertiary-container);
  }
  .type-int,
  .type-list {
    background: var(--md-sys-color-secondary-container);
    color: var(--md-sys-color-on-secondary-container);
  }
  .required {
    background: var(--md-sys-color-error-container);
    color: var(--md-sys-color-on-error-container);
  }
  .description {
    margin: 0;
    color: var(--md-sys-color-on-surface);
  }
  .field {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.375rem;
    font-size: var(--sl-text-sm);
  }
  .key {
    min-width: 4.5rem;
    color: var(--md-sys-color-on-surface-variant);
    font-weight: 500;
  }
  code,
  pre {
    padding: 0.125rem 0.375rem;
    border-radius: 0.375rem;
    background: var(--md-sys-color-surface-container-highest);
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-code-sm);
    overflow-wrap: anywhere;
  }
  pre {
    flex-basis: 100%;
    min-width: 0;
    margin: 0;
    padding: 0.75rem 1rem;
    overflow-x: auto;
  }
  .options {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.5rem;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
  }
  .options > :global(.variable) {
    background: var(--md-sys-color-surface-container);
  }
</style>
